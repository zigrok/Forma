<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Forma.Media</AssemblyName>
    <RootNamespace>Forma</RootNamespace>
    <PackageId Condition="'$(FormaRuntime)' == 'MonoGame'">Forma.Media.MonoGame</PackageId>
    <PackageId Condition="'$(FormaRuntime)' == 'FNA'">Forma.Media.FNA</PackageId>
    <VersionPrefix>$(FormaVersion)</VersionPrefix>
    <Description>Optional video integration for Forma.</Description>
    <PackageTags>forma;$(FormaRuntime);ui;video;media;game-development</PackageTags>
    <IsPackable>true</IsPackable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.111" PrivateAssets="All" />
    <ProjectReference Include="../Forma/Forma.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' == ''">
    <PackageReference Include="$(MonoGamePackageId)" Version="$(MonoGameVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' != ''">
    <ProjectReference Include="$(MonoGameProjectPath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'FNA' and '$(FnaProjectPath)' == ''">
    <PackageReference Include="$(FnaPackageId)" Version="$(FnaVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'FNA' and '$(FnaProjectPath)' != ''">
    <ProjectReference Include="$(FnaProjectPath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'MonoGame'">
    <Compile Remove="RuntimeAdapters/FNA/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'FNA'">
    <Compile Remove="RuntimeAdapters/MonoGame/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../RELEASE_NOTES.md" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="../../docs/dynamic-text.md" Pack="true" PackagePath="docs/" />
    <None Include="PackageGuards/Forma.Media.$(FormaRuntime).targets"
          Pack="true"
          PackagePath="buildTransitive/Forma.Media.$(FormaRuntime).targets" />
  </ItemGroup>

</Project>