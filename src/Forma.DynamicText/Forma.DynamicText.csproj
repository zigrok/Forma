<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Forma.DynamicText</AssemblyName>
    <RootNamespace>Forma</RootNamespace>
    <PackageId>Forma.DynamicText.$(FormaRuntime)</PackageId>
    <VersionPrefix>$(FormaVersion)</VersionPrefix>
    <Description>Optional runtime font loading, shaping, and rasterization dependencies for Forma.$(FormaRuntime).</Description>
    <PackageTags>forma;$(FormaRuntime);ui;fonts;text-shaping</PackageTags>
    <IsPackable>true</IsPackable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FormaDynamicTextBackend Condition="'$(FormaDynamicTextBackend)' == '' and '$(FormaBuildTarget)' == 'Browser'">External</FormaDynamicTextBackend>
    <FormaDynamicTextBackendSource Condition="'$(FormaDynamicTextBackendSource)' == '' and '$(FormaBuildTarget)' == 'Browser'">$(MSBuildThisFileDirectory)Browser/BrowserDynamicTextBackend.cs</FormaDynamicTextBackendSource>
    <FormaDynamicTextBackend Condition="'$(FormaDynamicTextBackend)' == ''">FreeTypeHarfBuzz</FormaDynamicTextBackend>
    <DefineConstants Condition="'$(FormaDynamicTextBackend)' == 'External'">$(DefineConstants);FORMA_EXTERNAL_DYNAMIC_TEXT_BACKEND</DefineConstants>
    <DefineConstants Condition="'$(FormaBuildTarget)' == 'Browser'">$(DefineConstants);FORMA_BROWSER_DYNAMIC_TEXT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Browser/**/*.cs" />
    <ProjectReference Include="../Forma/Forma.csproj"
              AdditionalProperties="FormaRuntime=$(FormaRuntime);MonoGameProjectPath=$(MonoGameProjectPath)"
              Condition="'$(FormaRuntime)' == 'MonoGame'" />
    <ProjectReference Include="../Forma/Forma.csproj"
              AdditionalProperties="FormaRuntime=$(FormaRuntime);FnaProjectPath=$(FnaProjectPath)"
              Condition="'$(FormaRuntime)' == 'FNA'" />
    <Compile Include="../Forma/DynamicFont.cs" Link="DynamicFont.cs" />
    <Compile Include="../Forma/DynamicTextNativeBackend.cs" Link="DynamicTextNativeBackend.cs" />
    <Compile Include="$(FormaDynamicTextBackendSource)" Link="PlatformDynamicTextBackend.cs" Condition="'$(FormaDynamicTextBackend)' == 'External' and '$(FormaDynamicTextBackendSource)' != ''" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="FreeTypeSharp" Version="$(FreeTypeSharpVersion)" Condition="'$(FormaDynamicTextBackend)' == 'FreeTypeHarfBuzz'" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzSharpVersion)" Condition="'$(FormaDynamicTextBackend)' == 'FreeTypeHarfBuzz'" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="$(HarfBuzzSharpVersion)" Condition="'$(FormaDynamicTextBackend)' == 'FreeTypeHarfBuzz'" />
  </ItemGroup>

    <Target Name="ValidateDynamicTextBackend" BeforeTargets="CoreCompile">
      <Error Condition="'$(FormaDynamicTextBackend)' != 'FreeTypeHarfBuzz' and '$(FormaDynamicTextBackend)' != 'External'"
        Text="FormaDynamicTextBackend must be FreeTypeHarfBuzz or External." />
      <Error Condition="'$(FormaDynamicTextBackend)' == 'External' and '$(FormaDynamicTextBackendSource)' == ''"
        Text="FormaDynamicTextBackendSource is required when FormaDynamicTextBackend=External." />
      <Error Condition="'$(FormaBuildTarget)' == 'Browser' and '$(FormaDynamicTextBackend)' != 'External'"
        Text="Browser DynamicText requires a statically linked External backend; desktop FreeTypeSharp/HarfBuzzSharp native assets are not browser libraries." />
    </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Forma.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' == ''">
    <PackageReference Include="$(MonoGamePackageId)" Version="$(MonoGameVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' != ''">
    <ProjectReference Include="$(MonoGameProjectPath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'FNA' and '$(FnaProjectPath)' == ''">
    <PackageReference Include="$(FnaPackageId)" Version="$(FnaVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'FNA' and '$(FnaProjectPath)' != ''">
    <ProjectReference Include="$(FnaProjectPath)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../RELEASE_NOTES.md" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="../../docs/dynamic-text.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/examples/DynamicTextQuickStart.cs" Pack="true" PackagePath="examples/" />
    <None Include="PackageBuild/Forma.DynamicText.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
    <None Include="PackageBuild/Forma.DynamicText.PackageInitializer.cs.txt" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../tests/Assets/Fonts/Inter_Regular.ttf" Pack="true" PackagePath="buildTransitive/assets/Inter_Regular.ttf" />
    <None Include="../../tests/Assets/Fonts/LICENSE.Inter.txt" Pack="true" PackagePath="licenses/fonts/LICENSE.Inter.txt" />
  </ItemGroup>

</Project>