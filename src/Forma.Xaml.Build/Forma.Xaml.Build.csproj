<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Forma.Xaml.Build</AssemblyName>
    <RootNamespace>Forma.Xaml.Build</RootNamespace>
    <PackageId Condition="'$(FormaRuntime)' == 'MonoGame'">Forma.Xaml.Build.MonoGame</PackageId>
    <PackageId Condition="'$(FormaRuntime)' == 'FNA'">Forma.Xaml.Build.FNA</PackageId>
    <VersionPrefix>$(FormaVersion)</VersionPrefix>
    <Description>Build-time compiler and MSBuild integration for Forma XAML.</Description>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.3.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.3.3" PrivateAssets="All" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" PrivateAssets="All" GeneratePathProperty="true" />
    <PackageReference Include="$(MonoGamePackageId)" Version="$(MonoGameVersion)" PrivateAssets="All" Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' == ''" />
    <PackageReference Include="$(FnaPackageId)" Version="$(FnaVersion)" PrivateAssets="All" Condition="'$(FormaRuntime)' == 'FNA'" />
    <ProjectReference Include="$(MonoGameProjectPath)" Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' != ''" PrivateAssets="All" />
    <ProjectReference Include="../Forma.Xaml.Compiler/Forma.Xaml.Compiler.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime);MonoGameProjectPath=$(MonoGameProjectPath)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forma.Xaml.Compiler.Tests" />
  </ItemGroup>

  <Target Name="CopyFormaXamlTaskDependencies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_FormaCecilDependency Include="$(PkgMono_Cecil)/lib/netstandard2.0/*.dll" />
      <_FormaPeerDependency Include="$([System.IO.Path]::Combine('$(NuGetPackageRoot)', $([System.String]::Copy('$(MonoGamePackageId)').ToLowerInvariant()), '$(MonoGameVersion)', 'lib'))/*/MonoGame.Framework.dll" Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' == ''" />
      <_FormaPeerDependency Include="$([System.IO.Path]::Combine('$(NuGetPackageRoot)', $([System.String]::Copy('$(FnaPackageId)').ToLowerInvariant()), '$(FnaVersion)', 'lib', 'net9.0', 'FNA.NET.dll'))" Condition="'$(FormaRuntime)' == 'FNA'" />
    </ItemGroup>
    <Error Condition="'$(MonoGameProjectPath)' == '' and '@(_FormaPeerDependency)' == ''" Text="The $(FormaRuntime) package does not contain the peer framework assembly required by Forma.Xaml.Build." />
    <Copy SourceFiles="@(_FormaCecilDependency);@(_FormaPeerDependency)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../RELEASE_NOTES.md" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="../../external/XamlX/LICENSE" Pack="true" PackagePath="licenses/XamlX/" />
    <None Include="buildTransitive/Forma.Xaml.Build.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
    <None Include="$(TargetDir)Forma.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(TargetDir)Forma.Xaml.Build.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(TargetDir)Forma.Xaml.Compiler.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(TargetDir)XamlX.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(TargetDir)XamlX.IL.Cecil.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(TargetDir)MonoGame.Framework.dll" Pack="true" PackagePath="tools/net10.0/" Condition="'$(FormaRuntime)' == 'MonoGame'" />
    <None Include="$(TargetDir)FNA.NET.dll" Pack="true" PackagePath="tools/net10.0/" Condition="'$(FormaRuntime)' == 'FNA'" />
    <None Include="$(PkgMono_Cecil)/lib/netstandard2.0/*.dll" Pack="true" PackagePath="tools/net10.0/" />
  </ItemGroup>

</Project>