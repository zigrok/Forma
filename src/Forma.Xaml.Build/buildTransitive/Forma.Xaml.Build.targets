<Project>
  <PropertyGroup>
    <FormaXamlBuildAssembly Condition="'$(FormaXamlBuildAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\Forma.Xaml.Build.dll</FormaXamlBuildAssembly>
    <FormaXamlValidateOnly Condition="'$(FormaXamlValidateOnly)' == ''">false</FormaXamlValidateOnly>
    <FormaXamlHotReload Condition="'$(FormaXamlHotReload)' == ''">false</FormaXamlHotReload>
    <FormaXamlAuthoring Condition="'$(FormaXamlAuthoring)' == ''">false</FormaXamlAuthoring>
    <FormaXamlRequireCompiledBindings Condition="'$(FormaXamlRequireCompiledBindings)' == '' and '$(Configuration)' == 'Release'">true</FormaXamlRequireCompiledBindings>
    <FormaXamlRequireCompiledBindings Condition="'$(FormaXamlRequireCompiledBindings)' == ''">false</FormaXamlRequireCompiledBindings>
    <FormaXamlIntermediateDirectory Condition="'$(FormaXamlIntermediateDirectory)' == ''">$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/FormaXaml</FormaXamlIntermediateDirectory>
    <FormaXamlIntermediateDirectory Condition="'$(FormaXamlAuthoring)' == 'true'">$(FormaXamlIntermediateDirectory)/authoring</FormaXamlIntermediateDirectory>
    <_FormaXamlCompilationInputsFile>$(FormaXamlIntermediateDirectory)/compilation-inputs.txt</_FormaXamlCompilationInputsFile>
    <_FormaXamlAuthoringIdentityFile Condition="'$(FormaXamlAuthoring)' == 'true'">$(FormaXamlIntermediateDirectory)/source-root.txt</_FormaXamlAuthoringIdentityFile>
    <FormaXamlDevelopmentOutputDirectory Condition="'$(FormaXamlDevelopmentOutputDirectory)' == ''">$(BaseOutputPath)$(Configuration)/$(TargetFramework)/xaml</FormaXamlDevelopmentOutputDirectory>
  </PropertyGroup>

  <UsingTask TaskName="Forma.Xaml.Build.DiscoverFormaXaml" AssemblyFile="$(FormaXamlBuildAssembly)" />
  <UsingTask TaskName="Forma.Xaml.Build.CompileFormaXaml" AssemblyFile="$(FormaXamlBuildAssembly)" />
  <UsingTask TaskName="Forma.Xaml.Build.ValidateFormaSvg" AssemblyFile="$(FormaXamlBuildAssembly)" />

  <ItemGroup Condition="'$(FormaXamlAuthoring)' == 'true'">
    <AdditionalFiles Include="$(_FormaXamlAuthoringIdentityFile)" />
  </ItemGroup>
  <Target Name="FormaXamlAuthoringIdentity" BeforeTargets="CoreCompile" Condition="'$(FormaXamlAuthoring)' == 'true'">
    <MakeDir Directories="$(FormaXamlIntermediateDirectory)" />
    <WriteLinesToFile File="$(_FormaXamlAuthoringIdentityFile)" Lines="$(FormaXamlSourceRoot)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup Condition="'$(EnableDefaultItems)' == 'true' and '$(EnableDefaultNoneItems)' == 'true'">
    <FormaXaml Include="**/*.xaml" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <FormaSvg Include="**/*.svg" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <None Remove="@(FormaXaml)" />
    <None Remove="@(FormaSvg)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cecil injection must start from a pristine assembly when XAML or its compiler changes. -->
    <AdditionalFiles Include="@(FormaXaml)" />
    <AdditionalFiles Include="$(_FormaXamlCompilationInputsFile)" />
    <CustomAdditionalCompileInputs Include="$(FormaXamlBuildAssembly);$(MSBuildThisFileFullPath)" Condition="'@(FormaXaml)' != ''" />
  </ItemGroup>

  <Target Name="FormaXamlCompilationInputs" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup Condition="'@(FormaXaml)' != ''">
      <!-- XAML resolves implementation assemblies, not only Roslyn's API-only reference assemblies. -->
      <CustomAdditionalCompileInputs Include="@(ReferencePath)" />
    </ItemGroup>
    <MakeDir Directories="$(FormaXamlIntermediateDirectory)" />
    <WriteLinesToFile File="$(_FormaXamlCompilationInputsFile)"
                      Lines="Compiler=$(FormaXamlBuildAssembly);Authoring=$(FormaXamlAuthoring);Bindings=$(FormaXamlRequireCompiledBindings);ValidateOnly=$(FormaXamlValidateOnly);@(FormaXaml->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="FormaXamlValidateSvgAssets"
      BeforeTargets="AssignTargetPaths"
          Condition="'@(FormaSvg)' != ''">
    <ValidateFormaSvg SvgFiles="@(FormaSvg)"
                      AssemblyName="$(AssemblyName)"
                      ProjectDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ValidatedSvgFiles" ItemName="_FormaValidatedSvg" />
    </ValidateFormaSvg>
    <ItemGroup>
      <EmbeddedResource Include="@(_FormaValidatedSvg)" LogicalName="%(_FormaValidatedSvg.LogicalName)" />
    </ItemGroup>
  </Target>

  <Target Name="FormaXamlDiscover"
          BeforeTargets="CoreCompile"
          Condition="'@(FormaXaml)' != ''"
          Inputs="@(FormaXaml);$(FormaXamlBuildAssembly)"
          Outputs="$(FormaXamlIntermediateDirectory)/discovery.stamp">
    <MakeDir Directories="$(FormaXamlIntermediateDirectory)" />
    <DiscoverFormaXaml XamlFiles="@(FormaXaml)" RequireCompiledBindings="$(FormaXamlRequireCompiledBindings)"
                       Authoring="$(FormaXamlAuthoring)">
      <Output TaskParameter="Roots" ItemName="_FormaXamlRoots" />
    </DiscoverFormaXaml>
    <Touch Files="$(FormaXamlIntermediateDirectory)/discovery.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="FormaXamlValidateSigning"
          BeforeTargets="FormaXamlCompile"
          Condition="'@(FormaXaml)' != ''">
    <Error Condition="'$(SignAssembly)' == 'true'"
           Text="Forma XAML injection currently cannot modify a compiler-signed assembly. Disable signing or add an approved re-signing stage after FormaXamlCompile and before packaging." />
  </Target>

  <Target Name="FormaXamlCompile"
          AfterTargets="CoreCompile"
      BeforeTargets="ILLink;ComputeIlcCompileInputs;IlcCompile;LinkNative;PrepareForPublish;CopyFilesToOutputDirectory;Publish"
          DependsOnTargets="ResolveReferences"
          Condition="'@(FormaXaml)' != ''"
          Inputs="@(FormaXaml);@(IntermediateAssembly);$(FormaXamlBuildAssembly);$(MSBuildThisFileFullPath);@(ReferencePath);$(_FormaXamlAuthoringIdentityFile)"
          Outputs="$(FormaXamlIntermediateDirectory)/compile.stamp">
    <CompileFormaXaml XamlFiles="@(FormaXaml)"
                  TargetAssembly="@(IntermediateAssembly)"
                  ProjectDirectory="$(MSBuildProjectDirectory)"
                  TargetPdb="$(IntermediateOutputPath)$(TargetName).pdb"
                      References="@(ReferencePath)"
                      RequireCompiledBindings="$(FormaXamlRequireCompiledBindings)"
                      ValidateOnly="$(FormaXamlValidateOnly)"
                      Authoring="$(FormaXamlAuthoring)"
                      AuthoringSourceRoot="$(FormaXamlSourceRoot)" />
              <Touch Files="$(FormaXamlIntermediateDirectory)/compile.stamp" AlwaysCreate="true" />
  </Target>

            <Target Name="FormaXamlVerifyInjectionOrder"
                BeforeTargets="ILLink;ComputeIlcCompileInputs;IlcCompile;LinkNative;PrepareForPublish;CopyFilesToOutputDirectory;Publish"
               DependsOnTargets="FormaXamlCompile"
               Condition="'@(FormaXaml)' != '' and '$(FormaXamlValidateOnly)' != 'true'">
              <Error Condition="!Exists('$(FormaXamlIntermediateDirectory)/compile.stamp')"
                Text="Forma XAML injection must complete before trimming, AOT compilation, signing, output copy, or publishing." />
              <Error Condition="'@(IntermediateAssembly)' == '' or !Exists('@(IntermediateAssembly)')"
                Text="Forma XAML injection requires the compiled intermediate assembly before platform linking or packaging." />
            </Target>

  <Target Name="FormaXamlCopyDevelopmentSources"
          AfterTargets="FormaXamlCompile"
          Condition="'$(FormaXamlHotReload)' == 'true' and '$(Configuration)' == 'Debug' and '@(FormaXaml)' != ''">
    <Copy SourceFiles="@(FormaXaml)"
          DestinationFiles="@(FormaXaml->'$(FormaXamlDevelopmentOutputDirectory)/%(Identity)')"
          SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(FormaSvg)"
            DestinationFiles="@(FormaSvg->'$(FormaXamlDevelopmentOutputDirectory)/%(Identity)')"
            SkipUnchangedFiles="true"
            Condition="'@(FormaSvg)' != ''" />
  </Target>

  <Target Name="FormaXamlClean" AfterTargets="Clean">
    <RemoveDir Directories="$(FormaXamlIntermediateDirectory);$(FormaXamlDevelopmentOutputDirectory)" />
  </Target>
</Project>