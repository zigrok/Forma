<Project>
  <PropertyGroup>
    <FormaHostPropsPath>$([MSBuild]::GetPathOfFileAbove('Forma.Host.props', '$(MSBuildThisFileDirectory)..'))</FormaHostPropsPath>
  </PropertyGroup>

  <Import Project="$(FormaHostPropsPath)" Condition="'$(FormaHostPropsPath)' != ''" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryUrl>https://github.com/zigrok/Forma</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Igor Hipólito Vieira</Authors>
    <Copyright>Copyright (c) 2026 Igor Hipólito Vieira</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile Condition="'$(IsPackable)' == 'true'">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <FormaRuntimeWasDefaulted Condition="'$(FormaRuntime)' == ''">true</FormaRuntimeWasDefaulted>
    <FormaRuntime Condition="'$(FormaRuntime)' == ''">MonoGame</FormaRuntime>
    <FormaVersion>0.1.0-alpha.2</FormaVersion>
    <BaseIntermediateOutputPath>obj/$(FormaRuntime)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(FormaRuntime)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)Artifacts/packages/$(FormaRuntime)</PackageOutputPath>
    <MonoGameVersion>3.8.5</MonoGameVersion>
    <MonoGamePlatform Condition="'$(MonoGamePlatform)' == ''">DesktopGL</MonoGamePlatform>
    <MonoGamePackageId>MonoGame.Framework.$(MonoGamePlatform)</MonoGamePackageId>
    <MonoGamePackageId Condition="'$(MonoGamePlatform)' == 'Windows'">MonoGame.Framework.WindowsDX</MonoGamePackageId>
    <MonoGamePackageId Condition="'$(FormaNativeRuntime)' == 'true' And '$(MonoGamePlatform)' == 'DesktopVK'">MonoGame.Framework.Native</MonoGamePackageId>
    <FnaVersion>2.2.11.2602</FnaVersion>
    <FnaPackageId>FNA.NET</FnaPackageId>
    <FnaNativeAssetsVersion>2.1.2.2602</FnaNativeAssetsVersion>
    <FreeTypeSharpVersion>3.1.0</FreeTypeSharpVersion>
    <HarfBuzzSharpVersion>14.2.1.1</HarfBuzzSharpVersion>
    <Clipper2Version>2.0.0</Clipper2Version>
    <SvgSkiaVersion>5.2.0</SvgSkiaVersion>
    <SkiaSharpVersion>4.148.0</SkiaSharpVersion>
    <TargetFramework Condition="'$(FormaRuntime)' == 'MonoGame' and ('$(MonoGamePlatform)' == 'Windows' or '$(MonoGamePlatform)' == 'WindowsDX')">net10.0-windows</TargetFramework>
    <EnableWindowsTargeting Condition="'$(FormaRuntime)' == 'MonoGame' and ('$(MonoGamePlatform)' == 'Windows' or '$(MonoGamePlatform)' == 'WindowsDX')">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FormaRuntime" Value="$(FormaRuntime)" />
  </ItemGroup>

  <Target Name="ValidateFormaRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FormaRuntime)' != 'MonoGame' and '$(FormaRuntime)' != 'FNA'"
           Text="FormaRuntime must be either 'MonoGame' or 'FNA'." />
  </Target>

  <Target Name="RequireExplicitFormaRuntimeForPack" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(FormaRuntimeWasDefaulted)' == 'true'"
           Text="Pack requires an explicit FormaRuntime=MonoGame or FormaRuntime=FNA selection." />
  </Target>
</Project>