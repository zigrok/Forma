<Project>
  <PropertyGroup>
    <FormaHostPropsPath>$([MSBuild]::GetPathOfFileAbove('Forma.Host.props', '$(MSBuildThisFileDirectory)..'))</FormaHostPropsPath>
  </PropertyGroup>

  <Import Project="$(FormaHostPropsPath)" Condition="'$(FormaHostPropsPath)' != ''" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryUrl>https://github.com/zigrok/Forma</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Igor Hipólito Vieira</Authors>
    <Copyright>Copyright (c) 2026 Igor Hipólito Vieira</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile Condition="'$(IsPackable)' == 'true'">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <FormaRuntimeWasDefaulted Condition="'$(FormaRuntime)' == ''">true</FormaRuntimeWasDefaulted>
    <FormaRuntime Condition="'$(FormaRuntime)' == ''">MonoGame</FormaRuntime>
    <FormaBuildTarget Condition="'$(FormaBuildTarget)' == ''">Desktop</FormaBuildTarget>
    <FormaVersion>0.1.0-alpha.2</FormaVersion>
    <!-- A consumer that supplies its own MonoGame/FNA *project* resolves the runtime differently
         from a standalone build, which takes the package. Both used to share obj/$(FormaRuntime),
         so whichever restored last won and the other inherited its project.assets.json - producing
         two assemblies named MonoGame.Framework and a CS1704 that points at an innocent project.
         Keeping the two restores apart is what makes "build Forma, then build the app that embeds
         it" work in one checkout. -->
    <FormaRuntimeSource Condition="'$(FormaRuntime)' == 'MonoGame' And '$(MonoGameProjectPath)' != ''">Project</FormaRuntimeSource>
    <FormaRuntimeSource Condition="'$(FormaRuntime)' == 'FNA' And '$(FnaProjectPath)' != ''">Project</FormaRuntimeSource>
    <FormaRuntimeSource Condition="'$(FormaRuntimeSource)' == ''">Package</FormaRuntimeSource>
    <BaseIntermediateOutputPath>obj/$(FormaRuntime)/$(FormaRuntimeSource)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(FormaRuntime)/$(FormaRuntimeSource)/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(FormaDynamicTextBackend)' == 'External'">obj/$(FormaRuntime)/$(FormaRuntimeSource)/External/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(FormaDynamicTextBackend)' == 'External'">bin/$(FormaRuntime)/$(FormaRuntimeSource)/External/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(FormaBuildTarget)' == 'Browser'">obj/$(FormaRuntime)/$(FormaRuntimeSource)/Browser/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(FormaBuildTarget)' == 'Browser'">bin/$(FormaRuntime)/$(FormaRuntimeSource)/Browser/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)Artifacts/packages/$(FormaRuntime)</PackageOutputPath>
    <MonoGameVersion>3.8.5</MonoGameVersion>
    <MonoGamePlatform Condition="'$(MonoGamePlatform)' == ''">DesktopGL</MonoGamePlatform>
    <MonoGamePackageId>MonoGame.Framework.$(MonoGamePlatform)</MonoGamePackageId>
    <MonoGamePackageId Condition="'$(MonoGamePlatform)' == 'Windows'">MonoGame.Framework.WindowsDX</MonoGamePackageId>
    <MonoGamePackageId Condition="'$(FormaNativeRuntime)' == 'true' And '$(MonoGamePlatform)' == 'DesktopVK'">MonoGame.Framework.Native</MonoGamePackageId>
    <FnaVersion>2.2.11.2602</FnaVersion>
    <FnaPackageId>FNA.NET</FnaPackageId>
    <FnaNativeAssetsVersion>2.1.2.2602</FnaNativeAssetsVersion>
    <FreeTypeSharpVersion>3.1.0</FreeTypeSharpVersion>
    <HarfBuzzSharpVersion>14.2.1.1</HarfBuzzSharpVersion>
    <Clipper2Version>2.0.0</Clipper2Version>
    <SvgSkiaVersion>5.2.0</SvgSkiaVersion>
    <SkiaSharpVersion>4.148.0</SkiaSharpVersion>
    <TargetFramework Condition="'$(FormaRuntime)' == 'MonoGame' and ('$(MonoGamePlatform)' == 'Windows' or '$(MonoGamePlatform)' == 'WindowsDX')">net10.0-windows</TargetFramework>
    <EnableWindowsTargeting Condition="'$(FormaRuntime)' == 'MonoGame' and ('$(MonoGamePlatform)' == 'Windows' or '$(MonoGamePlatform)' == 'WindowsDX')">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FormaRuntime" Value="$(FormaRuntime)" />
  </ItemGroup>

  <Target Name="ValidateFormaRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FormaRuntime)' != 'MonoGame' and '$(FormaRuntime)' != 'FNA'"
           Text="FormaRuntime must be either 'MonoGame' or 'FNA'." />
    <Error Condition="'$(FormaBuildTarget)' != 'Desktop' and '$(FormaBuildTarget)' != 'Browser'"
           Text="FormaBuildTarget must be Desktop or Browser." />
    <Error Condition="'$(FormaBuildTarget)' == 'Browser' and ('$(FormaRuntime)' != 'MonoGame' or '$(MonoGameProjectPath)' == '')"
           Text="Browser builds require FormaRuntime=MonoGame and MonoGameProjectPath pointing to the browser framework project." />
    <Error Condition="'$(FormaBuildTarget)' == 'Browser' and ('$(MSBuildProjectName)' == 'Forma.Xaml.Build' or '$(MSBuildProjectName)' == 'Forma.Xaml.Compiler' or '$(MSBuildProjectName)' == 'Forma.Xaml.HotReload')"
           Text="XAML tooling is desktop-only. Build Forma.Xaml.Build separately with FormaBuildTarget=Desktop and an independent desktop MonoGameProjectPath (or the default package), then set FormaXamlBuildAssembly in the browser module." />
  </Target>

  <Target Name="RequireExplicitFormaRuntimeForPack" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(FormaRuntimeWasDefaulted)' == 'true'"
           Text="Pack requires an explicit FormaRuntime=MonoGame or FormaRuntime=FNA selection." />
  </Target>
</Project>