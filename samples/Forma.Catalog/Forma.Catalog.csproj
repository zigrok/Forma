<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Forma.Catalog</AssemblyName>
    <RootNamespace>Forma.Catalog</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <CatalogBackend Condition="'$(CatalogBackend)' == ''">$(FormaRuntime)</CatalogBackend>
    <FormaXamlBuildAssembly>$(MSBuildThisFileDirectory)../../src/Forma.Xaml.Build/bin/$(FormaRuntime)/$(Configuration)/net10.0/Forma.Xaml.Build.dll</FormaXamlBuildAssembly>
    <FormaXamlHotReload Condition="'$(FormaXamlHotReload)' == '' And '$(Configuration)' == 'Debug'">true</FormaXamlHotReload>
    <FormaXamlHotReload Condition="'$(FormaXamlHotReload)' == ''">false</FormaXamlHotReload>
    <DefineConstants Condition="'$(FormaXamlHotReload)' == 'true'">$(DefineConstants);FORMA_XAML_HOT_RELOAD</DefineConstants>
    <DefineConstants Condition="'$(FormaRuntime)' == 'FNA'">$(DefineConstants);FORMA_CATALOG_FNA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(MonoGamePackageId)" Version="$(MonoGameVersion)" Condition="'$(FormaRuntime)' == 'MonoGame' and '$(MonoGameProjectPath)' == ''" />
    <PackageReference Include="$(FnaPackageId)" Version="$(FnaVersion)" Condition="'$(FormaRuntime)' == 'FNA' and '$(FnaProjectPath)' == ''" />
    <ProjectReference Include="../../src/Forma/Forma.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime)" GlobalPropertiesToRemove="CatalogBackend" />
    <ProjectReference Include="../../src/Forma.DynamicText/Forma.DynamicText.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime)" GlobalPropertiesToRemove="CatalogBackend" />
    <ProjectReference Include="../../src/Forma.Media/Forma.Media.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime)" GlobalPropertiesToRemove="CatalogBackend" />
    <ProjectReference Include="../../src/Forma.Xaml.Build/Forma.Xaml.Build.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime)" GlobalPropertiesToRemove="CatalogBackend" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Forma.Xaml.HotReload/Forma.Xaml.HotReload.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime)" GlobalPropertiesToRemove="CatalogBackend" Condition="'$(FormaXamlHotReload)' == 'true'" />
    <ProjectReference Include="../../src/Forma.Xaml.Compiler/Forma.Xaml.Compiler.csproj" AdditionalProperties="FormaRuntime=$(FormaRuntime)" GlobalPropertiesToRemove="CatalogBackend" PrivateAssets="All" Condition="'$(FormaXamlHotReload)' == 'true'" />
    <AssemblyMetadata Include="FormaCatalogBackend" Value="$(CatalogBackend)" />
    <AssemblyMetadata Include="FormaCatalogXamlRoot" Value="$(MSBuildProjectDirectory)" Condition="'$(FormaXamlHotReload)' == 'true'" />
    <InternalsVisibleTo Include="Forma.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/runtime-catalog.svg" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../docs/reference/control-families.json" LogicalName="Forma.Catalog.control-families.json" />
    <None Include="../../tests/Assets/Fonts/Inter_Regular.ttf" Link="Fonts/Inter_Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/NotoSansCJK_Subset.ttf" Link="Fonts/NotoSansCJK_Subset.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/NotoSansArabic_Variable.ttf" Link="Fonts/NotoSansArabic_Variable.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/NotoSansDevanagari_Subset.ttf" Link="Fonts/NotoSansDevanagari_Subset.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/NotoSansHebrew_Subset.ttf" Link="Fonts/NotoSansHebrew_Subset.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/NotoEmoji_Subset.ttf" Link="Fonts/NotoEmoji_Subset.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/LICENSE.Inter.txt" Link="Fonts/LICENSE.Inter.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/LICENSE.NotoSubsets.txt" Link="Fonts/LICENSE.NotoSubsets.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/LICENSE.NotoSansArabic.txt" Link="Fonts/LICENSE.NotoSansArabic.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'MonoGame'">
    <Compile Remove="RuntimeAdapters/FNA/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(FormaRuntime)' == 'FNA'">
    <Compile Remove="RuntimeAdapters/MonoGame/**/*.cs" />
  </ItemGroup>

  <Import Project="../../src/Forma.Xaml.Build/buildTransitive/Forma.Xaml.Build.targets" />

</Project>
